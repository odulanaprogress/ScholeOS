# ==============================================================================
# ScholeOS Backend Environment Variables
# ==============================================================================

# Database Connection (Neon / Supabase / Local PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scholeos"

# Clerk Authentication (Server-Side)
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"

# Clerk Webhook Secret (from Clerk Dashboard -> Webhooks -> Signing Secret)
# Used by identity-service / webhooks.ts via Svix
CLERK_WEBHOOK_SIGNING_SECRET="whsec_your_clerk_webhook_signing_secret"

# Application Environment
NODE_ENV="development"
PORT=4000

# ==============================================================================
# Firebase Admin SDK (Wave 2 & Wave 3)
# Project ID: scholesos (with historical typo)
# Service Account Key values for Cloudflare Workers / Server-side writes
# ==============================================================================
FIREBASE_PROJECT_ID="scholesos"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@scholesos.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# Or optional path/JSON:
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
